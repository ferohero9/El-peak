# El-Peak environment configuration
# Copy to .env (or key.env) and fill in real values. In production
# (Railway etc.) set these as environment variables instead.

# Required — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Required for auth token signing — 32+ random chars in production
SECRET_KEY=change-me-to-a-long-random-string

# Required for AI features — https://console.groq.com
GROQ_API_KEY=

# Background job queue (PDF processing). Without Redis the app still boots
# and everything else works, but PDF uploads return a clear 503 and the
# log explains why. The Docker image starts the ARQ worker automatically;
# outside Docker run:  python -m arq worker.WorkerSettings
REDIS_URL=redis://localhost:6379

# Optional
# SENTRY_DSN=
# ALLOWED_ORIGINS=https://yourdomain
# RATE_LIMIT_SECONDS=15
# AUTH_RATE_LIMIT_SECONDS=12

# El-Peak Study Companion - Environment Configuration
# Copy this file to .env and fill in your API keys

# Groq API Key (required for AI-generated quizzes and coaching)
# Get yours free at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenRouter API Key (alternative to Groq)
# OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Customize the AI model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
